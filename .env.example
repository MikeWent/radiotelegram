export TELEGRAM_BOT_TOKEN=
export TELEGRAM_CHAT_ID=
export TELEGRAM_TOPIC_ID=
export AUDIO_DEVICE=hw:0,0
export AUDIO_OUTPUT_DEVICE=hw:0,0
export TX_VOLUME_CONTROL=Master
export TX_VOLUME=75%
export RX_VOLUME_CONTROL=Mic
export RX_VOLUME=100%

# TX wake-up tone (frequency in Hz, duration and following delay in seconds)
# Set TX_WAKE_TONE_DURATION=0 to disable the tone and following delay.
export TX_WAKE_TONE_FREQUENCY=1750
export TX_WAKE_TONE_DURATION=0.3
export TX_WAKE_TONE_DELAY=0.5

# Voice detection (lower thresholds increase sensitivity)
export VAD_THRESHOLD=0.5
export VAD_MIN_VOICE_RATIO=0.01
export VAD_MIN_MAX_PROBABILITY=0.55
export VAD_MIN_AVG_PROBABILITY=0.2
export VAD_MIN_ANALYSIS_DURATION=0.5

# Live squelch (combined audio-level and VAD probability score)
export SQUELCH_OPEN_THRESHOLD=0.65
export SQUELCH_CLOSE_THRESHOLD=0.55
export SQUELCH_MIN_ABSOLUTE_LEVEL_DB=-40.0
